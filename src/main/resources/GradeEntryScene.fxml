<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    OtterCon Labs Project2: Grades Slice 4
    Author: Jit Tran
    Since: 08/04/2026
-->
<VBox fx:id="gradeEntryRoot"
      id="gradeEntryRoot"
      alignment="TOP_CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="8.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GradeEntryController">

    <padding>
        <Insets bottom="20.0"
                left="30.0"
                right="30.0"
                top="20.0" />
    </padding>

    <children>
        <Label text="Grades &amp; Statistics">
            <font>
                <Font name="System Bold"
                      size="18.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT"
              spacing="8.0">
            <children>
                <Label text="Course:" />

                <ComboBox fx:id="courseComboBox"
                          maxWidth="1.7976931348623157E308"
                          promptText="Select a course"
                          HBox.hgrow="ALWAYS" />

                <Label text="Assignment:" />

                <ComboBox fx:id="assignmentComboBox"
                          maxWidth="1.7976931348623157E308"
                          promptText="Select an assignment"
                          HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <Label fx:id="gradeMessageLabel"
               text="Grade records will appear in this table."
               wrapText="true">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <TableView fx:id="gradeTable"
                   VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No grades to display." />
            </placeholder>

            <columns>
                <TableColumn fx:id="studentIDColumn"
                             prefWidth="100.0"
                             text="Student ID" />

                <TableColumn fx:id="studentNameColumn"
                             prefWidth="150.0"
                             text="Student Name" />

                <TableColumn fx:id="scoreColumn"
                             prefWidth="100.0"
                             text="Score" />

                <TableColumn fx:id="feedbackColumn"
                             prefWidth="150.0"
                             text="Feedback" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT"
              spacing="8.0">
            <children>
                <Label text="Score:" />

                <TextField fx:id="scoreField"
                           prefWidth="100.0"
                           promptText="Enter score" />

                <Label text="Feedback:" />

                <TextField fx:id="feedbackField"
                           maxWidth="1.7976931348623157E308"
                           promptText="Optional feedback"
                           HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <HBox alignment="CENTER"
              minWidth="100.0"
              prefHeight="40.0"
              prefWidth="100.0"
              spacing="10.0">
            <children>
                <Button fx:id="saveButton"
                        defaultButton="true"
                        mnemonicParsing="false"
                        onAction="#handleSave"
                        prefWidth="100.0"
                        text="Save Grade" />

                <Button fx:id="deleteButton"
                        mnemonicParsing="false"
                        onAction="#handleDelete"
                        prefWidth="100.0"
                        text="Delete Grade" />

                <Button fx:id="backButton"
                        mnemonicParsing="false"
                        onAction="#handleBack"
                        prefWidth="120.0"
                        text="Back to Dashboard" />
            </children>
        </HBox>
    </children>
</VBox>