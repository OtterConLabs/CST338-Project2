<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    OtterCon Labs Project2: Grade Statistics Slice 4
    Author: Jit Tran
    Since: 08/14/2026
-->
<VBox fx:id="statisticsRoot"
      id="statisticsRoot"
      alignment="TOP_CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="8.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="StatisticsController">

    <padding>
        <Insets bottom="20.0"
                left="30.0"
                right="30.0"
                top="20.0" />
    </padding>

    <children>
        <Label text="Grade Statistics">
            <font>
                <Font name="System Bold"
                      size="18.0" />
            </font>
        </Label>

        <Label fx:id="assignmentTitleLabel"
               text="Selected Assignment">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <GridPane alignment="CENTER"
                  hgap="12.0"
                  vgap="4.0">
            <children>
                <Label text="Graded:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0" />

                <Label fx:id="gradedCountLabel"
                       text="0"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0" />

                <Label text="Ungraded:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0" />

                <Label fx:id="ungradedCountLabel"
                       text="0"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="0" />

                <Label text="Mean:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1" />

                <Label fx:id="meanLabel"
                       text="N/A"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1" />

                <Label text="Median:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1" />

                <Label fx:id="medianLabel"
                       text="N/A"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="1" />

                <Label text="Minimum:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2" />

                <Label fx:id="minimumLabel"
                       text="N/A"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2" />

                <Label text="Maximum:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2" />

                <Label fx:id="maximumLabel"
                       text="N/A"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <Label fx:id="statisticsMessageLabel"
               text="No grades recorded yet"
               wrapText="true">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <BarChart fx:id="distributionChart"
                  animated="false"
                  legendVisible="false"
                  title="Grade Distribution"
                  VBox.vgrow="ALWAYS">
            <xAxis>
                <CategoryAxis label="Percentage Range" />
            </xAxis>

            <yAxis>
                <NumberAxis forceZeroInRange="true"
                            label="Students"
                            minorTickVisible="false"
                            tickUnit="1.0" />
            </yAxis>
        </BarChart>

        <HBox alignment="CENTER"
              minWidth="100.0"
              prefHeight="40.0"
              prefWidth="100.0"
              spacing="10.0">
            <children>
                <Button fx:id="backButton"
                        mnemonicParsing="false"
                        onAction="#handleBack"
                        prefWidth="120.0"
                        text="Back to Grades" />
            </children>
        </HBox>
    </children>
</VBox>