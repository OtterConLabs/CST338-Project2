<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    CST338 Project2 - Slice 2: Courses & Enrollment
    Add/Edit Course form. The same scene serves both cases; the title label
    switches based on whether a course was selected for editing.
    Capacity is the extra-credit seat limit; blank means unlimited.
    Author: Brent Brewington
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="CourseEditController"
      spacing="12.0">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <children>
        <Label fx:id="formTitleLabel" text="Add Course"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="110.0" prefWidth="110.0"/>
                <ColumnConstraints prefWidth="380.0"/>
            </columnConstraints>

            <children>
                <Label text="Course Code:"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="codeField" promptText="CST338"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Course Name:"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" promptText="Software Design"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Teacher:"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="teacherCombo" prefWidth="380.0"
                          promptText="Select a teacher"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Description:"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Capacity:"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="capacityField"
                           promptText="Leave blank for unlimited"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </children>
        </GridPane>

        <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: #b00020;"/>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="saveButton" text="Save" onAction="#handleSave"
                        defaultButton="true"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"
                        cancelButton="true"/>
            </children>
        </HBox>
    </children>
</VBox>
