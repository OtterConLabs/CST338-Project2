<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DashboardController">
   <children>
      <VBox alignment="CENTER" layoutX="-3.0" layoutY="-1.0" prefHeight="400.0" prefWidth="600.0" spacing="16.0">
         <children>
            <Label text="Dashboard">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="47.0" prefWidth="600.0" spacing="20.0">
               <children>
                  <Label text="Name:">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="userDisplayName" prefHeight="27.0" prefWidth="95.0" text="User Name">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="44.0" prefWidth="600.0" spacing="20.0">
               <children>
                  <Label text="Role:">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label text="User Role">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="83.0" prefWidth="600.0" spacing="30.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleProfile" text="Profile" />
                  <Button mnemonicParsing="false" onAction="#handleCourses" text="Course &amp; Enrollment" />
                  <Button mnemonicParsing="false" onAction="#handleAssignments" text="Assignments" />
               </children>
            </HBox>
            <Button mnemonicParsing="false" text="Back" />
         </children>
         <padding>
            <Insets top="30.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
