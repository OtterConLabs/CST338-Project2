<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="AssignmentFormController">

    <children>
        <VBox alignment="TOP_CENTER"
              spacing="15.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.topAnchor="20.0">

            <padding>
                <Insets bottom="20.0"
                        left="20.0"
                        right="20.0"
                        top="20.0" />
            </padding>

            <children>
                <Label fx:id="formTitleLabel"
                       text="Assignment Form">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Label>

                <GridPane hgap="15.0"
                          vgap="15.0">

                    <children>
                        <Label text="Title:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0" />

                        <TextField fx:id="titleField"
                                   promptText="Enter assignment title"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0" />

                        <Label text="Description:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />

                        <TextArea fx:id="descriptionArea"
                                  prefHeight="120.0"
                                  promptText="Enter assignment description"
                                  wrapText="true"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="1" />

                        <Label text="Due Date:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2" />

                        <DatePicker fx:id="dueDatePicker"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2" />

                        <Label text="Points Possible:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3" />

                        <TextField fx:id="pointsField"
                                   promptText="Enter points possible"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3" />
                    </children>
                </GridPane>

                <Label fx:id="formMessageLabel"
                       wrapText="true" />

                <HBox alignment="CENTER_RIGHT"
                      spacing="10.0">

                    <children>
                        <Button mnemonicParsing="false"
                                onAction="#handleSave"
                                text="Save" />

                        <Button mnemonicParsing="false"
                                onAction="#handleCancel"
                                text="Cancel" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>