<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="AssignmentListController">

    <children>
        <VBox alignment="TOP_CENTER"
              spacing="10.0"
              AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="10.0"
              AnchorPane.rightAnchor="10.0"
              AnchorPane.topAnchor="10.0">

            <padding>
                <Insets bottom="15.0"
                        left="15.0"
                        right="15.0"
                        top="15.0" />
            </padding>

            <children>
                <Label text="Assignments">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>

                <TableView fx:id="assignmentTable"
                           prefHeight="200.0"
                           prefWidth="200.0"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="courseColumn"
                                     prefWidth="90.0"
                                     text="Course" />

                        <TableColumn fx:id="titleColumn"
                                     prefWidth="240.0"
                                     text="Title" />

                        <TableColumn fx:id="dueDateColumn"
                                     prefWidth="120.0"
                                     text="Due Date" />

                        <TableColumn fx:id="pointsColumn"
                                     prefWidth="80.0"
                                     text="Points" />
                    </columns>
                </TableView>

                <Label maxWidth="1.7976931348623157E308"
                       text="Description:" />

                <TextArea fx:id="descriptionArea"
                          editable="false"
                          focusTraversable="false"
                          prefHeight="100.0"
                          promptText="Select an assignment to view its description"
                          wrapText="true" />

                <HBox alignment="CENTER_RIGHT"
                      prefHeight="50.0"
                      prefWidth="200.0"
                      spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false"
                                onAction="#handleAdd"
                                text="Add" />

                        <Button mnemonicParsing="false"
                                onAction="#handleDelete"
                                text="Delete" />

                        <Button mnemonicParsing="false"
                                onAction="#handleEdit"
                                text="Edit" />

                        <Button fx:id="backToCoursesButton"
                                mnemonicParsing="false"
                                onAction="#handleBackToCourses"
                                text="Back to Courses" />

                        <Button mnemonicParsing="false"
                                onAction="#handleBack"
                                text="Back to Dashboard" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
